# Configuration for the Playwright Debugger Tool

# Gemini API Key for AI-powered code generation and screenshot analysis
# Get your key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Specify the Gemini model to use for AI operations
# Examples: gemini-2.5-flash-lite, gemini-1.5-pro-latest, etc.
GEMINI_MODEL=gemini-2.5-flash-lite

# Authentication credentials for the target application
# These are used by the host-debug-editor.mjs script for logging in
# AUTH_EMAIL=debug@aicharged.io
# AUTH_PASSWORD=password

# Path to the Laravel log file (used by run-debug-session.py)
# This path is relative to the container's working directory if not absolute.
# The default in the script is: /docker/frontend/dev-aiio-platform-oleg/api/storage/logs/laravel.log
# If running in Docker, you might need to adjust this or ensure the log file is accessible.
# For simplicity, we'll keep the default path as it is, assuming it's accessible within the container's context or mounted.
# LARAVEL_LOG_PATH=/docker/frontend/dev-aiio-platform-oleg/api/storage/logs/laravel.log

# Directory for saving screenshots (used by host-debug-editor.mjs)
# This path is relative to the script's execution context.
# When running in Docker, this will be relative to the WORKDIR (/app).
# The Dockerfile mounts $(pwd)/frontend/test-results to /app/frontend/test-results,
# so this should align correctly.
# SCREENSHOT_DIR=frontend/test-results